# Local MySQL Connection Configuration Example
# Copy this file to application-local.properties and fill in your local MySQL credentials.
# application-local.properties is ignored by git to protect credentials.

DB_URL=jdbc:mysql://localhost:3306/salary_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
server.port=8081

